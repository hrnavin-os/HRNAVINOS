# ==================== Application ====================
APP_NAME=HRNAVINOS ERP
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-characters

# ==================== Server ====================
HOST=0.0.0.0
PORT=8000

# ==================== Database (MongoDB) ====================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hrnavinos_erp

# ==================== JWT ====================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=hrnavinos-erp

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== Rate Limiting ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# ==================== Redis (optional) ====================
REDIS_URL=

# ==================== File Storage ====================
STORAGE_BACKEND=local
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ENDPOINT_URL=

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_DIR=app/logs

# ==================== Superuser bootstrap ====================
FIRST_SUPERUSER_EMAIL=admin@hrnavinos.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
