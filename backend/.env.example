# ==================== Application ====================
APP_NAME=HRNAVINOS ERP
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-characters

# ==================== Server ====================
HOST=0.0.0.0
PORT=8000

# ==================== Database (MongoDB) ====================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hrnavinos_erp

# ==================== JWT ====================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=hrnavinos-erp

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== Frontend (for post-OAuth redirects) ====================
FRONTEND_URL=http://localhost:5173

# ==================== Google OAuth (Marketing Board / Sheets integration) ====================
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# enable the Google Sheets API, and add GOOGLE_OAUTH_REDIRECT_URI below as an
# Authorized redirect URI on that client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-sheets/callback

# ==================== Lead Dashboard <-> Google Sheet two-way sync ====================
# Induction tab <-> Induction Leads, Foundation tab <-> All Leads. On by default
# only when APP_ENV=production - the sheet mirrors *this* database, so don't turn
# it on against the live spreadsheet from a dev machine.
#
# Credentials, preferred: a Google Cloud service account with the Sheets API
# enabled. Download its JSON key to the server, point GOOGLE_SERVICE_ACCOUNT_FILE
# at it, and share the spreadsheet with the key's client_email as Editor.
# Without one, the Google account connected on the Marketing Board is used (it
# must be reconnected once so it grants edit access).
# LEAD_SHEET_SYNC_ENABLED=true
LEAD_SHEET_SPREADSHEET_ID=1GuW1RzWnA1SsKIwmzRFXdIa7ERSb3EELnrWABkPSHnk
LEAD_SHEET_INDUCTION_TAB=Induction
LEAD_SHEET_FOUNDATION_TAB=Foundation
LEAD_SHEET_SYNC_INTERVAL_SECONDS=30
GOOGLE_SERVICE_ACCOUNT_FILE=

# ==================== WhatsApp Cloud API (HR group invites) ====================
# Leave blank and the HR board still works: Send invite opens WhatsApp with the
# message written and the coordinator presses send. Fill these in and the same
# button delivers it by itself.
#
# From Meta (developers.facebook.com > your app > WhatsApp > API Setup):
#   PHONE_NUMBER_ID  the "Phone number ID" on that page, not the phone number
#   ACCESS_TOKEN     a permanent token from a System User, not the 24h test one
#   TEMPLATE_NAME    a template you have created AND had approved under
#                    Message Templates. WhatsApp only lets a business open a
#                    conversation with an approved template, and an invite is
#                    always the business speaking first.
#
# The template must take two body variables, in this order:
#   {{1}} candidate name    {{2}} group invite link
# e.g. "Hi {{1}}, welcome to HRNAVINOS! Join your batch group here: {{2}}"
#
# Note this sends the candidate the invite *link*. No WhatsApp API can add
# somebody to a group - they always tap the link themselves.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ==================== Rate Limiting ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# ==================== Redis (optional) ====================
REDIS_URL=

# ==================== File Storage ====================
STORAGE_BACKEND=local
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ENDPOINT_URL=

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_DIR=app/logs

# ==================== Superuser bootstrap ====================
FIRST_SUPERUSER_EMAIL=admin@hrnavinos.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

# Google Meet attendance (Success Meet / Foundation Class), read from the
# Workspace Meet audit log through the Admin SDK Reports API. Uses the Google
# service account above, which needs domain-wide delegation for the scope
# https://www.googleapis.com/auth/admin.reports.audit.readonly, acting as a
# Workspace admin who can view reports. Leave unset to mark attendance by hand.
GOOGLE_MEET_ADMIN_EMAIL=
MEET_SYNC_INTERVAL_MINUTES=15
MEET_AUTO_SYNC_DAYS=3
