# ==================== Claude Code harness state ====================
.claude/scheduled_tasks.lock
# Machine-local: enables the auto-push Stop hook. Deliberately not shared --
# nobody should inherit "every edit pushes to main" by cloning the repo.
.claude/settings.local.json

# ==================== Python / Backend ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
.eggs/
build/
dist/

# Backend runtime
backend/app/uploads/*
!backend/app/uploads/.gitkeep
backend/app/logs/*
!backend/app/logs/.gitkeep
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.mypy_cache/
backend/.ruff_cache/
backend/_mongo_test_runtime/
backend/_mongodb_data/
backend/_local_mongo_server.py

# ==================== Node / Frontend ====================
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== Environment / Secrets ====================
.env
.env.*
!.env.example
!.env.*.example
!frontend/.env.production
*.pem
*.key
!nginx/*.key.example
# Google service-account private keys - what GOOGLE_SERVICE_ACCOUNT_FILE
# points at for the Sheets export. A key arrives as an ordinary .json, which
# none of the rules above catch, and this repo auto-commits and auto-pushes:
# an unignored key dropped in the tree would be on GitHub within seconds.
*service-account*.json
*service_account*.json
*-credentials.json
gcp-*.json

# ==================== Editors / OS ====================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==================== Logs ====================
*.log
logs/

